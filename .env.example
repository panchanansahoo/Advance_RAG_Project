# ============================================================
# Advanced Multimodal & Agentic RAG — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# ── Application ──────────────────────────────────────────────
APP_NAME=Advanced RAG
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:5500"]

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password_change_me
POSTGRES_DB=advanced_rag

# ── Vector Database (Qdrant) ────────────────────────────────
VECTOR_DB_PROVIDER=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# ── Vector Database (ChromaDB — alternative) ────────────────
# VECTOR_DB_PROVIDER=chroma
# CHROMA_PERSIST_DIR=./chroma_data

# ── Embedding Model ─────────────────────────────────────────
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# For OpenAI embeddings:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# ── LLM Provider ────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# For Gemini:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash

# ── API Keys ────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# ── Ingestion ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.csv,.xlsx,.docx,.png,.jpg,.jpeg

# ── Chunking ────────────────────────────────────────────────
CHUNK_STRATEGY=fixed
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ── Retrieval ───────────────────────────────────────────────
RETRIEVAL_TOP_K=5
